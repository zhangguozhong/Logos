<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LogosDecoder</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/Logos.ico</ApplicationIcon>
    <StartupObject>Logos.Decoder.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <AvaloniaResource Include="Assets/Logos.png" />
    <ProjectReference Include="../cli/LogosCli.csproj" />
  </ItemGroup>
</Project>
