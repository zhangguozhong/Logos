<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>Logos</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeSource>../../Packages/com.company.logos/Runtime</RuntimeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RuntimeSource)/Core/**/*.cs;$(RuntimeSource)/Storage/Engine/**/*.cs;$(RuntimeSource)/Transport/Core/**/*.cs" Exclude="$(RuntimeSource)/**/AssemblyInfo.cs" />
    <InternalsVisibleTo Include="logos-cli" />
  </ItemGroup>
</Project>
